{
  "menu": [
    {
      "label": "File",
      "submenu": [
        {
          "label": "Move Tab to New Window",
          "command": "tabs:open-in-new-window",
          "group": "external",
          "order": 40
        },
        {
          "label": "Close Tabs",
          "submenu": [
            {
              "label": "Other Tabs in Pane",
              "command": "tabs:close-other-tabs"
            },
            {
              "label": "Tabs to the Right",
              "command": "tabs:close-tabs-to-right"
            },
            {
              "label": "Tabs to the Left",
              "command": "tabs:close-tabs-to-left"
            },
            {
              "label": "Unmodified Tabs in Pane",
              "command": "tabs:close-saved-tabs"
            },
            {
              "label": "All Tabs in Pane",
              "command": "tabs:close-all-tabs"
            },
            {
              "label": "All Tabs in Workspace",
              "command": "tabs:close-all-tabs-in-workspace"
            }
          ],
          "group": "close",
          "order": 20
        }
      ]
    },
    {
      "label": "Packages",
      "submenu": [
        {
          "label": "Tabs",
          "submenu": [
            {
              "label": "Close Tab",
              "command": "tabs:close-tab"
            },
            {
              "label": "Split Tab",
              "submenu": [
                {
                  "label": "Above",
                  "command": "tabs:split-up"
                },
                {
                  "label": "Below",
                  "command": "tabs:split-down"
                },
                {
                  "label": "Left",
                  "command": "tabs:split-left"
                },
                {
                  "label": "Right",
                  "command": "tabs:split-right"
                }
              ]
            },
            {
              "label": "Move Tab to New Window",
              "command": "tabs:open-in-new-window"
            },
            {
              "label": "Close Tabs",
              "submenu": [
                {
                  "label": "Other Tabs in Pane",
                  "command": "tabs:close-other-tabs"
                },
                {
                  "label": "Tabs to the Right",
                  "command": "tabs:close-tabs-to-right"
                },
                {
                  "label": "Tabs to the Left",
                  "command": "tabs:close-tabs-to-left"
                },
                {
                  "label": "Unmodified Tabs in Pane",
                  "command": "tabs:close-saved-tabs"
                },
                {
                  "label": "All Tabs in Pane",
                  "command": "tabs:close-all-tabs"
                },
                {
                  "label": "All Tabs in Workspace",
                  "command": "tabs:close-all-tabs-in-workspace"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "context-menu": {
    ".tab": {
      "groupOrder": ["views", "history", "layout", "transfer", "extensions", "close", "visibility"],
      "items": [
        {
          "type": "separator"
        },
        {
          "label": "Close Tab",
          "command": "tabs:close-tab",
          "group": "close",
          "order": 10
        },
        {
          "label": "Close Other Tabs",
          "command": "tabs:close-other-tabs",
          "group": "close",
          "order": 20
        },
        {
          "label": "Close Tabs to the Right",
          "command": "tabs:close-tabs-to-right",
          "group": "close",
          "order": 30
        },
        {
          "label": "Close Tabs to the Left",
          "command": "tabs:close-tabs-to-left",
          "group": "close",
          "order": 40
        },
        {
          "label": "Close Unmodified Tabs in Pane",
          "command": "tabs:close-saved-tabs",
          "group": "close",
          "order": 50
        },
        {
          "label": "Close All Tabs in Pane",
          "command": "tabs:close-all-tabs",
          "group": "close",
          "order": 60
        },
        {
          "type": "separator"
        },
        // Core's own pane group, in core's order and under core's labels: the
        // tab bar is a sibling of `.item-views`, never a descendant, so core's
        // block cannot reach this menu and nothing here collides with it. A
        // submenu would only make the user hunt for four rows they already know
        // from the pane menu.
        {
          "label": "Split Up",
          "command": "tabs:split-up",
          "afterGroupContaining": ["tabs:close-tab"],
          "group": "layout",
          "order": 10
        },
        {
          "label": "Split Down",
          "command": "tabs:split-down",
          "group": "layout",
          "order": 20
        },
        {
          "label": "Split Left",
          "command": "tabs:split-left",
          "group": "layout",
          "order": 30
        },
        {
          "label": "Split Right",
          "command": "tabs:split-right",
          "group": "layout",
          "order": 40
        },
        {
          "type": "separator"
        }
      ]
    },
    "lumine-pane:not(lumine-dock lumine-pane) .tab": [
      { "type": "separator" },
      {
        "label": "Detach Tab",
        "command": "tabs:detach-tab",
        "afterGroupContaining": ["tabs:split-up", "tabs:close-tab"],
        "group": "transfer",
        "order": 10
      },
      { "type": "separator" },
      {
        "label": "Detach Pane",
        "command": "pane:detach",
        "afterGroupContaining": [
          "tabs:detach-tab",
          "tabs:open-in-new-window",
          "tabs:split-up",
          "tabs:close-tab"
        ],
        "group": "transfer",
        "order": 30
      },
      {
        "label": "Close Pane",
        "command": "pane:close",
        "group": "close",
        "order": 90
      },
      { "type": "separator" }
    ],
    "lumine-dock .tab": [
      { "type": "separator" },
      {
        "label": "Close Pane",
        "command": "pane:close",
        "afterGroupContaining": [
          "tabs:detach-tab",
          "tabs:open-in-new-window",
          "tabs:split-up",
          "tabs:close-tab"
        ],
        "group": "close",
        "order": 90
      },
      { "type": "separator" }
    ],
    ".tab.texteditor": [
      {
        "type": "separator"
      },
      {
        "label": "Move Tab to New Window",
        "command": "tabs:open-in-new-window",
        "after": ["tabs:detach-tab"],
        "afterGroupContaining": ["tabs:split-up", "tabs:close-tab"],
        "group": "transfer",
        "order": 20
      },
      {
        "type": "separator"
      }
    ],
    ".tab-bar": {
      "groupOrder": ["views", "history", "layout", "transfer", "extensions", "close", "visibility"],
      "items": [
        {
          "type": "separator"
        },
        {
          "label": "Reopen Closed Tab",
          "command": "pane:reopen-closed-item",
          "after": ["tabs:close-all-tabs"],
          "group": "history",
          "order": 10
        },
        {
          "type": "separator"
        }
      ]
    },
    "lumine-dock .tab-bar": [
      {
        "type": "separator"
      },
      {
        "label": "Hide Dock",
        "command": "dock:hide",
        "group": "visibility",
        "order": 10
      },
      {
        "type": "separator"
      }
    ]
  }
}
