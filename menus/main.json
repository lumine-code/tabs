  "context-menu": {
    ".tab": [
      {
        "type": "separator"
      },
      {
        "label": "Close Tab",
        "command": "tabs:close-tab"
      },
      {
        "label": "Close Other Tabs",
        "command": "tabs:close-other-tabs"
      },
      {
        "label": "Close Tabs to the Right",
        "command": "tabs:close-tabs-to-right"
      },
      {
        "label": "Close Tabs to the Left",
        "command": "tabs:close-tabs-to-left"
      },
      {
        "label": "Close Saved Tabs",
        "command": "tabs:close-saved-tabs"
      },
      {
        "label": "Close All Tabs",
        "command": "tabs:close-all-tabs"
      },
      {
        "type": "separator"
      },
      // Core's own pane group, in core's order and under core's labels: the
      // tab bar is a sibling of `.item-views`, never a descendant, so core's
      // block cannot reach this menu and nothing here collides with it. A
      // submenu would only make the user hunt for four rows they already know
      // from the pane menu.
      {
        "label": "Split Up",
        "command": "tabs:split-up",
        "afterGroupContaining": ["tabs:close-tab"]
      },
      {
        "label": "Split Down",
        "command": "tabs:split-down"
      },
      {
        "label": "Split Left",
        "command": "tabs:split-left"
      },
      {
        "label": "Split Right",
        "command": "tabs:split-right"
      },
      {
        "type": "separator"
      }
    ],
    "lumine-pane:not(lumine-dock lumine-pane) .tab": [
      { "type": "separator" },
      {
        "label": "Detach Tab",
        "command": "tabs:detach-tab",
        "afterGroupContaining": ["tabs:split-up", "tabs:close-tab"]
      },
      { "type": "separator" },
      {
        "label": "Detach Pane",
        "command": "pane:detach",
        "afterGroupContaining": [
          "tabs:detach-tab",
          "tabs:open-in-new-window",
          "tabs:split-up",
          "tabs:close-tab"
        ]
      },
      { "label": "Close Pane", "command": "pane:close" },
      { "type": "separator" }
    ],
    "lumine-dock .tab": [
      { "type": "separator" },
      {
        "label": "Close Pane",
        "command": "pane:close",
        "afterGroupContaining": [
          "tabs:detach-tab",
          "tabs:open-in-new-window",
          "tabs:split-up",
          "tabs:close-tab"
        ]
      },
      { "type": "separator" }
    ],
    ".tab.texteditor": [
      {
        "type": "separator"
      },
      {
        "label": "Open in New Window",
        "command": "tabs:open-in-new-window",
        "after": ["tabs:detach-tab"],
        "afterGroupContaining": ["tabs:split-up", "tabs:close-tab"]
      },
      {
        "type": "separator"
      }
    ],
    ".tab-bar": [
      {
        "type": "separator"
      },
      {
        "label": "Reopen Closed Tab",
        "command": "pane:reopen-closed-item",
        "after": ["tabs:close-all-tabs"]
      },
      {
        "type": "separator"
      }
    ],
    "lumine-dock .tab-bar": [
      {
        "type": "separator"
      },
      {
        "label": "Hide Dock",
        "command": "dock:hide"
      },
      {
        "type": "separator"
      }
    ]
  }
}
